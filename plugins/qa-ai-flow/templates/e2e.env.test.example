# Copy this file to .env.test (gitignored) and fill in real values.
# See CLAUDE.md's "Environment Variables" section for the full reference.

# Application URLs
BASE_URL=http://localhost:3000
API_URL=http://localhost:8000
API_LOGIN_PATH=/api/login

# Admin credentials (for API seed/teardown and the admin panel login helper)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourAdminPassword

# Test user credentials (frontend auth)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=TestPassword123!

# Add below only after auth method is confirmed:
# NEXTAUTH_SECRET=...          (if NextAuth.js)
# NEXTAUTH_URL=http://localhost:3000  (if NextAuth.js)
# GOOGLE_CLIENT_ID=...         (if OAuth)
# GOOGLE_CLIENT_SECRET=...     (if OAuth)
# WP_USER=...                  (if WordPress login)
# WP_APP_PASSWORD=...          (if seeding through the WordPress REST API)
